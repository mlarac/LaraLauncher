<UserControl x:Class="LaraLauncher.App.Controls.VirtualKeyboardControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <UserControl.Resources>
        <Style x:Key="RokuVirtualKeyButtonStyle" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Background" Value="#241745" />
            <Setter Property="Foreground" Value="#F7F5FF" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Height" Value="46" />
            <Setter Property="Margin" Value="4" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="KeyBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="#3C2C63"
                                BorderThickness="1.5"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="4,0" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsActionKey}" Value="True">
                                <Setter TargetName="KeyBorder" Property="Background" Value="#31205C" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsPrimaryDoneKey}" Value="True">
                                <Setter TargetName="KeyBorder" Property="Background" Value="#5A2EA6" />
                                <Setter TargetName="KeyBorder" Property="BorderBrush" Value="#B695FF" />
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="KeyBorder" Property="Background" Value="#3D2B6E" />
                                <Setter TargetName="KeyBorder" Property="BorderBrush" Value="#B695FF" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="KeyBorder" Property="Background" Value="#7E4AE8" />
                                <Setter TargetName="KeyBorder" Property="BorderBrush" Value="#FFFFFF" />
                                <Setter TargetName="KeyBorder" Property="BorderThickness" Value="2.5" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border Background="#180F30"
            BorderBrush="{StaticResource RokuSubtleBorderBrush}"
            BorderThickness="1.5"
            CornerRadius="14"
            Padding="12">
        <StackPanel>
            <DockPanel Margin="6,0,6,8">
                <TextBlock DockPanel.Dock="Right"
                           Text="Flechas / D-Pad: Mover  •  Enter / A: Pulsar  •  Esc / B: Volver"
                           FontSize="12"
                           Foreground="{StaticResource RokuTextMutedBrush}"
                           VerticalAlignment="Center" />
                <TextBlock x:Name="KeyboardHeaderText"
                           Text="Teclado Virtual"
                           FontSize="14"
                           FontWeight="Bold"
                           Foreground="{StaticResource RokuAccentBrightBrush}"
                           VerticalAlignment="Center" />
            </DockPanel>

            <ItemsControl x:Name="KeysGrid" Focusable="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="10" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{StaticResource RokuVirtualKeyButtonStyle}"
                                Content="{Binding Label}"
                                Click="KeyButton_Click"
                                GotKeyboardFocus="KeyButton_GotKeyboardFocus" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </Border>
</UserControl>
