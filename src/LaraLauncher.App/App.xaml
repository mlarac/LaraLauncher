<Application x:Class="LaraLauncher.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:LaraLauncher.App.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/RokuTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
            <converters:HexToBrushConverter x:Key="HexToBrush" />
            <converters:FilePathToImageConverter x:Key="FilePathToImage" />
            <converters:FileExistsToVisibilityConverter x:Key="FileExistsToVisibility" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
