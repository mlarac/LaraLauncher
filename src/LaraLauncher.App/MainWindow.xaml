<Window x:Class="LaraLauncher.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:LaraLauncher.App.Views"
        mc:Ignorable="d"
        Title="LaraLauncher"
        Width="1280"
        Height="720"
        MinWidth="960"
        MinHeight="540"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource RokuMainBackgroundBrush}"
        Foreground="{StaticResource RokuTextPrimaryBrush}"
        PreviewKeyDown="Window_PreviewKeyDown"
        Loaded="Window_Loaded"
        Activated="Window_Activated"
        Deactivated="Window_Deactivated">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="290" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Left Roku-style Sidebar -->
        <Border Grid.Column="0"
                Background="{StaticResource RokuSidebarBrush}"
                BorderBrush="{StaticResource RokuSubtleBorderBrush}"
                BorderThickness="0,0,1,0"
                Padding="22,34,22,28">
            <DockPanel LastChildFill="True">
                <!-- Brand -->
                <StackPanel DockPanel.Dock="Top" Margin="10,0,0,34">
                    <TextBlock Text="LaraLauncher"
                               FontFamily="Segoe UI"
                               FontSize="30"
                               FontWeight="Bold"
                               Foreground="{StaticResource RokuTextPrimaryBrush}" />
                    <TextBlock Text="10-Foot Desktop Hub"
                               FontSize="13"
                               Foreground="{StaticResource RokuAccentBrightBrush}"
                               Margin="2,2,0,0" />
                </StackPanel>

                <!-- Hint footer -->
                <Border DockPanel.Dock="Bottom"
                        Background="#1E1338"
                        CornerRadius="10"
                        Padding="14,12"
                        Margin="4,16,4,0">
                    <StackPanel>
                        <TextBlock Text="Controles"
                                   FontSize="12"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource RokuAccentBrightBrush}" />
                        <TextBlock Text="Flechas: Navegar  •  Enter: Abrir"
                                   FontSize="12"
                                   Foreground="{StaticResource RokuTextMutedBrush}"
                                   Margin="0,4,0,0" />
                        <TextBlock Text="M / Menú: Opciones  •  Esc: Atrás"
                                   FontSize="12"
                                   Foreground="{StaticResource RokuTextMutedBrush}"
                                   Margin="0,2,0,0" />
                        <TextBlock Text="F11: Pantalla completa"
                                   FontSize="12"
                                   Foreground="{StaticResource RokuTextMutedBrush}"
                                   Margin="0,2,0,0" />
                    </StackPanel>
                </Border>

                <!-- Navigation Items -->
                <ItemsControl x:Name="SidebarItemsControl"
                              ItemsSource="{Binding SidebarItems}"
                              Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource RokuSidebarButtonStyle}"
                                    Tag="{Binding Section}"
                                    Click="SidebarButton_Click"
                                    GotKeyboardFocus="SidebarButton_GotKeyboardFocus">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Glyph}"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="20"
                                               VerticalAlignment="Center"
                                               Margin="0,0,14,0" />
                                    <TextBlock Text="{Binding Title}"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>
        </Border>

        <!-- Right Main Content Area -->
        <Grid Grid.Column="1" Margin="40,32,40,28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Top Header: Section Title + Weather Summary + Live Clock -->
            <Grid Grid.Row="0" Margin="12,0,12,22">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding SectionTitle}"
                               FontSize="34"
                               FontWeight="Bold"
                               Foreground="{StaticResource RokuTextPrimaryBrush}" />
                    <TextBlock Text="Presiona M o clic derecho sobre una tarjeta para mover, editar o quitar"
                               FontSize="14"
                               Foreground="{StaticResource RokuTextMutedBrush}"
                               Margin="0,4,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Weather Summary Pill (clickable to open Weather section) -->
                    <Button Background="Transparent"
                            BorderThickness="0"
                            Padding="0"
                            Margin="0,0,18,0"
                            Cursor="Hand"
                            Focusable="False"
                            Click="WeatherHeaderPill_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="#261847"
                                        BorderBrush="{StaticResource RokuSubtleBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="12"
                                        Padding="16,10"
                                        VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Weather.HeaderIcon}"
                                                   FontFamily="Segoe UI Emoji"
                                                   FontSize="20"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,10,0" />
                                        <TextBlock Text="{Binding Weather.HeaderSummaryText}"
                                                   FontSize="16"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource RokuTextPrimaryBrush}"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- Clock -->
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Right">
                        <TextBlock Text="{Binding CurrentTimeText}"
                                   FontSize="30"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Right"
                                   Foreground="{StaticResource RokuTextPrimaryBrush}" />
                        <TextBlock Text="{Binding CurrentDateText}"
                                   FontSize="13"
                                   HorizontalAlignment="Right"
                                   Foreground="{StaticResource RokuTextMutedBrush}" />
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- Move Mode Banner -->
            <Border Grid.Row="1"
                    Visibility="{Binding IsMoveMode, Converter={StaticResource BoolToVisibility}}"
                    Background="#7E4AE8"
                    BorderBrush="#FFFFFF"
                    BorderThickness="2"
                    CornerRadius="12"
                    Padding="20,12"
                    Margin="12,0,12,16">
                <TextBlock Text="{Binding MoveModeBannerText}"
                           FontSize="16"
                           FontWeight="Bold"
                           Foreground="#FFFFFF" />
            </Border>

            <!-- Home Section: Roku Tile Grid -->
            <ScrollViewer x:Name="HomeScrollViewer"
                          Grid.Row="2"
                          Visibility="{Binding IsHomeGridVisible, Converter={StaticResource BoolToVisibility}}"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Focusable="False">
                <ItemsControl x:Name="TileGridControl"
                              ItemsSource="{Binding AppTiles}"
                              Focusable="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid x:Name="TileUniformGrid"
                                         Columns="{Binding DataContext.GridColumns, RelativeSource={RelativeSource AncestorType=Window}}"
                                         HorizontalAlignment="Left"
                                         VerticalAlignment="Top" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource RokuTileButtonStyle}"
                                    Command="{Binding DataContext.LaunchTileCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}"
                                    GotKeyboardFocus="TileButton_GotKeyboardFocus"
                                    MouseRightButtonUp="TileButton_MouseRightButtonUp">
                                <Grid ClipToBounds="True">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="44" />
                                    </Grid.RowDefinitions>

                                    <!-- Top Graphic Area: Extracted PNG Icon or Fallback Glyph -->
                                    <Border Grid.Row="0"
                                            CornerRadius="12,12,0,0"
                                            Background="{Binding AccentHex, Converter={StaticResource HexToBrush}}">
                                        <Grid>
                                            <Border>
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                        <GradientStop Color="#33FFFFFF" Offset="0" />
                                                        <GradientStop Color="#22000000" Offset="1" />
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                            </Border>

                                            <Image Source="{Binding IconPath, Converter={StaticResource FilePathToImage}}"
                                                   Visibility="{Binding IconPath, Converter={StaticResource FileExistsToVisibility}}"
                                                   Width="64"
                                                   Height="64"
                                                   RenderOptions.BitmapScalingMode="HighQuality"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />

                                            <TextBlock Text="{Binding FallbackGlyph}"
                                                       Visibility="{Binding IconPath, Converter={StaticResource FileExistsToVisibility}, ConverterParameter=Invert}"
                                                       FontFamily="Segoe MDL2 Assets"
                                                       FontSize="46"
                                                       Foreground="#FFFFFF"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>

                                    <!-- Bottom Title Bar -->
                                    <Border Grid.Row="1"
                                            Background="#1A1130"
                                            CornerRadius="0,0,12,12"
                                            Padding="14,0">
                                        <DockPanel VerticalAlignment="Center">
                                            <TextBlock DockPanel.Dock="Right"
                                                       Text="{Binding Category}"
                                                       FontSize="12"
                                                       Foreground="{StaticResource RokuTextMutedBrush}"
                                                       VerticalAlignment="Center"
                                                       Margin="8,0,0,0" />
                                            <TextBlock Text="{Binding Name}"
                                                       FontSize="16"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource RokuTextPrimaryBrush}"
                                                       TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center" />
                                        </DockPanel>
                                    </Border>
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Home Empty State -->
            <Border x:Name="HomeEmptyState"
                    Grid.Row="2"
                    Visibility="{Binding IsHomeEmptyVisible, Converter={StaticResource BoolToVisibility}}"
                    Background="#1F143B"
                    BorderBrush="{StaticResource RokuSubtleBorderBrush}"
                    BorderThickness="1.5"
                    CornerRadius="18"
                    Padding="42,38"
                    Margin="12"
                    VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Text="&#xE71D;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="44"
                               Foreground="{StaticResource RokuAccentBrightBrush}"
                               Margin="0,0,0,14" />
                    <TextBlock Text="Tu pantalla de inicio está lista"
                               FontSize="28"
                               FontWeight="Bold" />
                    <TextBlock Text="Aún no has agregado aplicaciones a LaraLauncher. Abre el gestor gráfico para marcar tus aplicaciones instaladas en Windows o carga un conjunto básico de prueba."
                               FontSize="16"
                               Foreground="{StaticResource RokuTextMutedBrush}"
                               TextWrapping="Wrap"
                               MaxWidth="680"
                               HorizontalAlignment="Left"
                               Margin="0,10,0,28" />
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="EmptyManageAppsButton"
                                Content="Elegir aplicaciones instaladas"
                                Style="{StaticResource RokuActionButtonStyle}"
                                Margin="0,0,16,0"
                                Click="EmptyManageAppsButton_Click" />
                        <Button x:Name="EmptyAddStarterButton"
                                Content="Cargar apps básicas de Windows"
                                Style="{StaticResource RokuActionButtonStyle}"
                                Click="EmptyAddStarterButton_Click" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Graphical Manage Apps Section (Phase 3) -->
            <views:AppManagerView x:Name="AppManagerViewControl"
                                  Grid.Row="2"
                                  DataContext="{Binding AppManager}"
                                  Visibility="{Binding DataContext.IsManageAppsSection, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}"
                                  AppToggled="AppManagerView_AppToggled"
                                  ManualFileSelected="AppManagerView_ManualFileSelected"
                                  RefreshRequested="AppManagerView_RefreshRequested"
                                  ExitToSidebarRequested="AppManagerView_ExitToSidebarRequested" />

            <!-- WebApps Creator + 10-Foot Virtual Keyboard Section -->
            <views:WebAppCreatorView x:Name="WebAppCreatorViewControl"
                                     Grid.Row="2"
                                     DataContext="{Binding WebAppCreator}"
                                     Visibility="{Binding DataContext.IsWebAppsSection, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}"
                                     CreateWebAppRequested="WebAppCreatorView_CreateWebAppRequested"
                                     ExitToSidebarRequested="WebAppCreatorView_ExitToSidebarRequested" />

            <!-- Weather & 7-Day Forecast Section (Phase 4) -->
            <views:WeatherDetailView x:Name="WeatherDetailViewControl"
                                     Grid.Row="2"
                                     DataContext="{Binding Weather}"
                                     Visibility="{Binding DataContext.IsWeatherSection, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}"
                                     ExitToSidebarRequested="WeatherDetailView_ExitToSidebarRequested" />

            <!-- System Settings & Power Section (Phase 5) -->
            <views:SettingsView x:Name="SettingsViewControl"
                                Grid.Row="2"
                                DataContext="{Binding Settings}"
                                Visibility="{Binding DataContext.IsSettingsSection, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}"
                                ExitToSidebarRequested="SettingsView_ExitToSidebarRequested" />

            <!-- Status Toast Notification -->
            <Border Grid.Row="2"
                    Visibility="{Binding IsStatusToastVisible, Converter={StaticResource BoolToVisibility}}"
                    Background="#E62A1B52"
                    BorderBrush="{StaticResource RokuAccentBrightBrush}"
                    BorderThickness="1.5"
                    CornerRadius="12"
                    Padding="20,12"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Margin="12">
                <TextBlock Text="{Binding StatusToast}"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Foreground="#FFFFFF" />
            </Border>
        </Grid>

        <!-- Tile Context Menu Overlay (100% Keyboard/Remote navigable) -->
        <Grid x:Name="TileContextOverlay"
              Grid.ColumnSpan="2"
              Background="#CC0A0514"
              Visibility="{Binding IsTileContextMenuVisible, Converter={StaticResource BoolToVisibility}}">
            <Border Background="#20143D"
                    BorderBrush="{StaticResource RokuAccentBrightBrush}"
                    BorderThickness="2"
                    CornerRadius="18"
                    Padding="34,28"
                    Width="440"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" BlurRadius="35" ShadowDepth="0" Opacity="0.7" />
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="{Binding ContextTile.Name}"
                               FontSize="24"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="Opciones de tarjeta"
                               FontSize="14"
                               Foreground="{StaticResource RokuTextMutedBrush}"
                               HorizontalAlignment="Center"
                               Margin="0,4,0,22" />

                    <Button x:Name="ContextMoveButton"
                            Content="Mover tarjeta en la grilla"
                            Style="{StaticResource RokuActionButtonStyle}"
                            Margin="0,0,0,10"
                            Click="ContextMoveButton_Click" />
                    <Button x:Name="ContextEditButton"
                            Content="Editar nombre, categoría y color"
                            Style="{StaticResource RokuActionButtonStyle}"
                            Margin="0,0,0,10"
                            Click="ContextEditButton_Click" />
                    <Button x:Name="ContextRemoveButton"
                            Content="Quitar de Inicio"
                            Style="{StaticResource RokuActionButtonStyle}"
                            Margin="0,0,0,10"
                            Click="ContextRemoveButton_Click" />
                    <Button x:Name="ContextCancelButton"
                            Content="Cancelar"
                            Style="{StaticResource RokuActionButtonStyle}"
                            Click="ContextCancelButton_Click" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Edit Tile Dialog Overlay -->
        <Grid x:Name="EditTileOverlay"
              Grid.ColumnSpan="2"
              Background="#CC0A0514"
              Visibility="{Binding IsEditTileDialogVisible, Converter={StaticResource BoolToVisibility}}">
            <Border Background="#20143D"
                    BorderBrush="{StaticResource RokuAccentBrightBrush}"
                    BorderThickness="2"
                    CornerRadius="18"
                    Padding="36,30"
                    Width="520"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" BlurRadius="35" ShadowDepth="0" Opacity="0.7" />
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="Editar tarjeta"
                               FontSize="24"
                               FontWeight="Bold"
                               Margin="0,0,0,20" />

                    <TextBlock Text="Nombre visible"
                               FontSize="14"
                               Foreground="{StaticResource RokuTextMutedBrush}"
                               Margin="0,0,0,6" />
                    <TextBox x:Name="EditNameTextBox"
                             Style="{StaticResource RokuTextBoxStyle}"
                             Text="{Binding EditTileName, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,0,0,16" />

                    <TextBlock Text="Categoría"
                               FontSize="14"
                               Foreground="{StaticResource RokuTextMutedBrush}"
                               Margin="0,0,0,6" />
                    <TextBox x:Name="EditCategoryTextBox"
                             Style="{StaticResource RokuTextBoxStyle}"
                             Text="{Binding EditTileCategory, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,0,0,16" />

                    <TextBlock Text="Color de tarjeta"
                               FontSize="14"
                               Foreground="{StaticResource RokuTextMutedBrush}"
                               Margin="0,0,0,8" />
                    <ItemsControl ItemsSource="{Binding AccentSwatches}" Margin="0,0,0,24">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Width="48"
                                        Height="36"
                                        Margin="0,0,10,0"
                                        Tag="{Binding}"
                                        Cursor="Hand"
                                        Click="AccentSwatchButton_Click">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="SwatchBorder"
                                                    CornerRadius="8"
                                                    Background="{Binding Converter={StaticResource HexToBrush}}"
                                                    BorderBrush="#66FFFFFF"
                                                    BorderThickness="2" />
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsKeyboardFocused" Value="True">
                                                    <Setter TargetName="SwatchBorder" Property="BorderBrush" Value="#FFFFFF" />
                                                    <Setter TargetName="SwatchBorder" Property="BorderThickness" Value="3" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="EditCancelButton"
                                Content="Cancelar"
                                Style="{StaticResource RokuActionButtonStyle}"
                                Margin="0,0,14,0"
                                Click="EditCancelButton_Click" />
                        <Button x:Name="EditSaveButton"
                                Content="Guardar"
                                Style="{StaticResource RokuActionButtonStyle}"
                                Click="EditSaveButton_Click" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Exit Confirmation Overlay -->
        <Grid x:Name="ExitOverlay"
              Grid.ColumnSpan="2"
              Background="#CC0A0514"
              Visibility="{Binding IsExitDialogVisible, Converter={StaticResource BoolToVisibility}}">
            <Border Background="#20143D"
                    BorderBrush="{StaticResource RokuAccentBrightBrush}"
                    BorderThickness="2"
                    CornerRadius="18"
                    Padding="38,32"
                    Width="480"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" BlurRadius="35" ShadowDepth="0" Opacity="0.7" />
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="{Binding PowerDialogTitle}"
                               FontSize="26"
                               FontWeight="Bold"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding PowerDialogSubtitle}"
                               FontSize="16"
                               Foreground="{StaticResource RokuTextMutedBrush}"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               HorizontalAlignment="Center"
                               Margin="0,10,0,28" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button x:Name="CancelExitButton"
                                Content="Cancelar"
                                Style="{StaticResource RokuActionButtonStyle}"
                                Margin="0,0,16,0"
                                Click="CancelExitButton_Click" />
                        <Button x:Name="ConfirmExitButton"
                                Content="{Binding PowerDialogConfirmText}"
                                Style="{StaticResource RokuActionButtonStyle}"
                                Click="ConfirmExitButton_Click" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
