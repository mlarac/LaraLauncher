<Window x:Class="LaraLauncher.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="LaraLauncher"
        Width="1280"
        Height="720"
        MinWidth="960"
        MinHeight="540"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource RokuMainBackgroundBrush}"
        Foreground="{StaticResource RokuTextPrimaryBrush}"
        PreviewKeyDown="Window_PreviewKeyDown"
        Loaded="Window_Loaded"
        Activated="Window_Activated"
        Deactivated="Window_Deactivated">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="290" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Left Roku-style Sidebar -->
        <Border Grid.Column="0"
                Background="{StaticResource RokuSidebarBrush}"
                BorderBrush="{StaticResource RokuSubtleBorderBrush}"
                BorderThickness="0,0,1,0"
                Padding="22,34,22,28">
            <DockPanel LastChildFill="True">
                <!-- Brand -->
                <StackPanel DockPanel.Dock="Top" Margin="10,0,0,34">
                    <TextBlock Text="LaraLauncher"
                               FontFamily="Segoe UI"
                               FontSize="30"
                               FontWeight="Bold"
                               Foreground="{StaticResource RokuTextPrimaryBrush}" />
                    <TextBlock Text="10-Foot Desktop Hub"
                               FontSize="13"
                               Foreground="{StaticResource RokuAccentBrightBrush}"
                               Margin="2,2,0,0" />
                </StackPanel>

                <!-- Hint footer -->
                <Border DockPanel.Dock="Bottom"
                        Background="#1E1338"
                        CornerRadius="10"
                        Padding="14,12"
                        Margin="4,16,4,0">
                    <StackPanel>
                        <TextBlock Text="Controles"
                                   FontSize="12"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource RokuAccentBrightBrush}" />
                        <TextBlock Text="Flechas: Navegar  •  Enter: Abrir"
                                   FontSize="12"
                                   Foreground="{StaticResource RokuTextMutedBrush}"
                                   Margin="0,4,0,0" />
                        <TextBlock Text="Esc / Back: Menú  •  F11: Pantalla"
                                   FontSize="12"
                                   Foreground="{StaticResource RokuTextMutedBrush}"
                                   Margin="0,2,0,0" />
                    </StackPanel>
                </Border>

                <!-- Navigation Items -->
                <ItemsControl x:Name="SidebarItemsControl"
                              ItemsSource="{Binding SidebarItems}"
                              Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource RokuSidebarButtonStyle}"
                                    Tag="{Binding Section}"
                                    Click="SidebarButton_Click"
                                    GotKeyboardFocus="SidebarButton_GotKeyboardFocus">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Glyph}"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="20"
                                               VerticalAlignment="Center"
                                               Margin="0,0,14,0" />
                                    <TextBlock Text="{Binding Title}"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>
        </Border>

        <!-- Right Main Content Area -->
        <Grid Grid.Column="1" Margin="40,32,40,28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Top Header: Section Title + Weather Summary + Live Clock -->
            <Grid Grid.Row="0" Margin="12,0,12,26">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding SectionTitle}"
                               FontSize="34"
                               FontWeight="Bold"
                               Foreground="{StaticResource RokuTextPrimaryBrush}" />
                    <TextBlock Text="Usa las flechas o tu control remoto para seleccionar"
                               FontSize="15"
                               Foreground="{StaticResource RokuTextMutedBrush}"
                               Margin="0,4,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Weather Summary Pill -->
                    <Border Background="#261847"
                            BorderBrush="{StaticResource RokuSubtleBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="16,10"
                            Margin="0,0,18,0"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="&#xE753;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="20"
                                       Foreground="{StaticResource RokuAccentBrightBrush}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,10,0" />
                            <TextBlock Text="{Binding WeatherSummaryText}"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource RokuTextPrimaryBrush}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <!-- Clock -->
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Right">
                        <TextBlock Text="{Binding CurrentTimeText}"
                                   FontSize="30"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Right"
                                   Foreground="{StaticResource RokuTextPrimaryBrush}" />
                        <TextBlock Text="{Binding CurrentDateText}"
                                   FontSize="13"
                                   HorizontalAlignment="Right"
                                   Foreground="{StaticResource RokuTextMutedBrush}" />
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- Home Section: Roku Tile Grid -->
            <ScrollViewer x:Name="HomeScrollViewer"
                          Grid.Row="1"
                          Visibility="{Binding IsHomeGridVisible, Converter={StaticResource BoolToVisibility}}"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Focusable="False">
                <ItemsControl x:Name="TileGridControl"
                              ItemsSource="{Binding AppTiles}"
                              Focusable="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid x:Name="TileUniformGrid"
                                         Columns="3"
                                         HorizontalAlignment="Left"
                                         VerticalAlignment="Top" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource RokuTileButtonStyle}"
                                    Command="{Binding DataContext.LaunchTileCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}"
                                    GotKeyboardFocus="TileButton_GotKeyboardFocus">
                                <Grid ClipToBounds="True">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="44" />
                                    </Grid.RowDefinitions>

                                    <!-- Top Graphic Area: Extracted PNG Icon or Fallback Glyph -->
                                    <Border Grid.Row="0"
                                            CornerRadius="12,12,0,0"
                                            Background="{Binding AccentHex, Converter={StaticResource HexToBrush}}">
                                        <Grid>
                                            <Border>
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                        <GradientStop Color="#33FFFFFF" Offset="0" />
                                                        <GradientStop Color="#22000000" Offset="1" />
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                            </Border>

                                            <Image Source="{Binding IconPath, Converter={StaticResource FilePathToImage}}"
                                                   Visibility="{Binding IconPath, Converter={StaticResource FileExistsToVisibility}}"
                                                   Width="64"
                                                   Height="64"
                                                   RenderOptions.BitmapScalingMode="HighQuality"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />

                                            <TextBlock Text="{Binding FallbackGlyph}"
                                                       Visibility="{Binding IconPath, Converter={StaticResource FileExistsToVisibility}, ConverterParameter=Invert}"
                                                       FontFamily="Segoe MDL2 Assets"
                                                       FontSize="46"
                                                       Foreground="#FFFFFF"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>

                                    <!-- Bottom Title Bar -->
                                    <Border Grid.Row="1"
                                            Background="#1A1130"
                                            CornerRadius="0,0,12,12"
                                            Padding="14,0">
                                        <DockPanel VerticalAlignment="Center">
                                            <TextBlock DockPanel.Dock="Right"
                                                       Text="{Binding Category}"
                                                       FontSize="12"
                                                       Foreground="{StaticResource RokuTextMutedBrush}"
                                                       VerticalAlignment="Center"
                                                       Margin="8,0,0,0" />
                                            <TextBlock Text="{Binding Name}"
                                                       FontSize="16"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource RokuTextPrimaryBrush}"
                                                       TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center" />
                                        </DockPanel>
                                    </Border>
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Home Empty State (Friendly first-run onboarding) -->
            <Border x:Name="HomeEmptyState"
                    Grid.Row="1"
                    Visibility="{Binding IsHomeEmptyVisible, Converter={StaticResource BoolToVisibility}}"
                    Background="#1F143B"
                    BorderBrush="{StaticResource RokuSubtleBorderBrush}"
                    BorderThickness="1.5"
                    CornerRadius="18"
                    Padding="42,38"
                    Margin="12"
                    VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Text="&#xE71D;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="44"
                               Foreground="{StaticResource RokuAccentBrightBrush}"
                               Margin="0,0,0,14" />
                    <TextBlock Text="Tu pantalla de inicio está lista"
                               FontSize="28"
                               FontWeight="Bold" />
                    <TextBlock Text="Aún no has agregado aplicaciones a LaraLauncher. Puedes cargar un conjunto básico de Windows para probar el lanzamiento real o ir al gestor de aplicaciones."
                               FontSize="16"
                               Foreground="{StaticResource RokuTextMutedBrush}"
                               TextWrapping="Wrap"
                               MaxWidth="680"
                               HorizontalAlignment="Left"
                               Margin="0,10,0,28" />
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="EmptyAddStarterButton"
                                Content="Cargar apps básicas de Windows"
                                Style="{StaticResource RokuActionButtonStyle}"
                                Margin="0,0,16,0"
                                Click="EmptyAddStarterButton_Click" />
                        <Button x:Name="EmptyManageAppsButton"
                                Content="Ir a Gestionar Apps"
                                Style="{StaticResource RokuActionButtonStyle}"
                                Click="EmptyManageAppsButton_Click" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Weather Placeholder (Phase 4) -->
            <Border Grid.Row="1"
                    Visibility="{Binding IsWeatherSection, Converter={StaticResource BoolToVisibility}}"
                    Background="#1F143B"
                    BorderBrush="{StaticResource RokuSubtleBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="16"
                    Padding="36"
                    Margin="12"
                    VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Text="Pronóstico del Tiempo — Próximamente en Fase 4"
                               FontSize="24"
                               FontWeight="Bold" />
                    <TextBlock Text="Aquí se mostrará el clima actual y el pronóstico detallado de los próximos 5 a 7 días usando Open-Meteo con caché local y buscador de ciudad."
                               FontSize="16"
                               Foreground="{StaticResource RokuTextMutedBrush}"
                               TextWrapping="Wrap"
                               Margin="0,12,0,0" />
                </StackPanel>
            </Border>

            <!-- Manage Apps Placeholder (Phase 3) -->
            <Border Grid.Row="1"
                    Visibility="{Binding IsManageAppsSection, Converter={StaticResource BoolToVisibility}}"
                    Background="#1F143B"
                    BorderBrush="{StaticResource RokuSubtleBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="16"
                    Padding="36"
                    Margin="12"
                    VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Text="Gestor Gráfico de Aplicaciones — Próximamente en Fase 3"
                               FontSize="24"
                               FontWeight="Bold" />
                    <TextBlock Text="Aquí podrás marcar gráficamente qué aplicaciones instaladas en Windows aparecen en LaraLauncher, agregar ejecutables manualmente, editar nombres y reordenar tarjetas sin tocar archivos de configuración."
                               FontSize="16"
                               Foreground="{StaticResource RokuTextMutedBrush}"
                               TextWrapping="Wrap"
                               Margin="0,12,0,0" />
                </StackPanel>
            </Border>

            <!-- Settings Placeholder (Phase 5) -->
            <Border Grid.Row="1"
                    Visibility="{Binding IsSettingsSection, Converter={StaticResource BoolToVisibility}}"
                    Background="#1F143B"
                    BorderBrush="{StaticResource RokuSubtleBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="16"
                    Padding="36"
                    Margin="12"
                    VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Text="Ajustes del Sistema — Próximamente en Fase 5"
                               FontSize="24"
                               FontWeight="Bold" />
                    <TextBlock Text="Aquí podrás activar el inicio automático con Windows, elegir tu ciudad y unidades (°C/°F), configurar soporte para mandos XInput y personalizar la apariencia."
                               FontSize="16"
                               Foreground="{StaticResource RokuTextMutedBrush}"
                               TextWrapping="Wrap"
                               Margin="0,12,0,0" />
                </StackPanel>
            </Border>

            <!-- Status Toast Notification -->
            <Border Grid.Row="1"
                    Visibility="{Binding IsStatusToastVisible, Converter={StaticResource BoolToVisibility}}"
                    Background="#E62A1B52"
                    BorderBrush="{StaticResource RokuAccentBrightBrush}"
                    BorderThickness="1.5"
                    CornerRadius="12"
                    Padding="20,12"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Margin="12">
                <TextBlock Text="{Binding StatusToast}"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Foreground="#FFFFFF" />
            </Border>
        </Grid>

        <!-- Exit Confirmation Overlay (100% Keyboard/Remote navigable) -->
        <Grid x:Name="ExitOverlay"
              Grid.ColumnSpan="2"
              Background="#CC0A0514"
              Visibility="{Binding IsExitDialogVisible, Converter={StaticResource BoolToVisibility}}">
            <Border Background="#20143D"
                    BorderBrush="{StaticResource RokuAccentBrightBrush}"
                    BorderThickness="2"
                    CornerRadius="18"
                    Padding="38,32"
                    Width="480"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" BlurRadius="35" ShadowDepth="0" Opacity="0.7" />
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="¿Salir de LaraLauncher?"
                               FontSize="26"
                               FontWeight="Bold"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="Volverás al escritorio de Windows."
                               FontSize="16"
                               Foreground="{StaticResource RokuTextMutedBrush}"
                               HorizontalAlignment="Center"
                               Margin="0,10,0,28" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button x:Name="CancelExitButton"
                                Content="Cancelar"
                                Style="{StaticResource RokuActionButtonStyle}"
                                Margin="0,0,16,0"
                                Click="CancelExitButton_Click" />
                        <Button x:Name="ConfirmExitButton"
                                Content="Salir"
                                Style="{StaticResource RokuActionButtonStyle}"
                                Click="ConfirmExitButton_Click" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
