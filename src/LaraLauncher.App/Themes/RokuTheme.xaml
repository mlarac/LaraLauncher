<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Palette inspired by Roku dark UI -->
    <Color x:Key="RokuBgDeepColor">#0F081E</Color>
    <Color x:Key="RokuBgMidColor">#1D1138</Color>
    <Color x:Key="RokuBgBottomColor">#120A24</Color>
    <Color x:Key="RokuAccentColor">#7E4AE8</Color>
    <Color x:Key="RokuAccentBrightColor">#B695FF</Color>
    <Color x:Key="RokuSurfaceColor">#23183E</Color>
    <Color x:Key="RokuSurfaceHoverColor">#312254</Color>
    <Color x:Key="RokuSidebarBgColor">#140C28</Color>
    <Color x:Key="RokuTextPrimaryColor">#F7F5FF</Color>
    <Color x:Key="RokuTextMutedColor">#B6ACC9</Color>

    <LinearGradientBrush x:Key="RokuMainBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{StaticResource RokuBgDeepColor}" Offset="0.0" />
        <GradientStop Color="{StaticResource RokuBgMidColor}" Offset="0.52" />
        <GradientStop Color="{StaticResource RokuBgBottomColor}" Offset="1.0" />
    </LinearGradientBrush>

    <SolidColorBrush x:Key="RokuSidebarBrush" Color="{StaticResource RokuSidebarBgColor}" Opacity="0.88" />
    <SolidColorBrush x:Key="RokuAccentBrush" Color="{StaticResource RokuAccentColor}" />
    <SolidColorBrush x:Key="RokuAccentBrightBrush" Color="{StaticResource RokuAccentBrightColor}" />
    <SolidColorBrush x:Key="RokuSurfaceBrush" Color="{StaticResource RokuSurfaceColor}" />
    <SolidColorBrush x:Key="RokuSurfaceHoverBrush" Color="{StaticResource RokuSurfaceHoverColor}" />
    <SolidColorBrush x:Key="RokuTextPrimaryBrush" Color="{StaticResource RokuTextPrimaryColor}" />
    <SolidColorBrush x:Key="RokuTextMutedBrush" Color="{StaticResource RokuTextMutedColor}" />
    <SolidColorBrush x:Key="RokuFocusBorderBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="RokuSubtleBorderBrush" Color="#342654" />

    <!-- Remove ugly default WPF dotted focus visual everywhere -->
    <Style TargetType="{x:Type Control}">
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    </Style>

    <!-- Roku Sidebar Navigation Button -->
    <Style x:Key="RokuSidebarButtonStyle" TargetType="Button">
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource RokuTextMutedBrush}" />
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="21" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Padding" Value="22,15" />
        <Setter Property="Margin" Value="0,4" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="RootBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="Transparent"
                            BorderThickness="2"
                            CornerRadius="12"
                            Padding="{TemplateBinding Padding}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="6" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="ActiveBar"
                                    Grid.Column="0"
                                    Width="4"
                                    Height="24"
                                    CornerRadius="2"
                                    Background="Transparent"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center" />
                            <ContentPresenter Grid.Column="1"
                                              Margin="10,0,0,0"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                            <Setter TargetName="RootBorder" Property="Background" Value="#2A1C4D" />
                            <Setter TargetName="ActiveBar" Property="Background" Value="{StaticResource RokuAccentBrightBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource RokuTextPrimaryBrush}" />
                        </DataTrigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="RootBorder" Property="Background" Value="{StaticResource RokuSurfaceHoverBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource RokuTextPrimaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="RootBorder" Property="Background" Value="{StaticResource RokuAccentBrush}" />
                            <Setter TargetName="RootBorder" Property="BorderBrush" Value="{StaticResource RokuFocusBorderBrush}" />
                            <Setter TargetName="ActiveBar" Property="Background" Value="#FFFFFF" />
                            <Setter Property="Foreground" Value="#FFFFFF" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Roku 16:9 Horizontal App Tile Button (Simple, clean, high-visibility focus) -->
    <Style x:Key="RokuTileButtonStyle" TargetType="Button">
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Width" Value="272" />
        <Setter Property="Height" Value="162" />
        <Setter Property="Margin" Value="12" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
        <Setter Property="RenderTransform">
            <Setter.Value>
                <ScaleTransform ScaleX="1" ScaleY="1" />
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="CardBorder"
                            CornerRadius="14"
                            Background="{StaticResource RokuSurfaceBrush}"
                            BorderBrush="{StaticResource RokuSubtleBorderBrush}"
                            BorderThickness="2"
                            SnapsToDevicePixels="True">
                        <Border.Effect>
                            <DropShadowEffect x:Name="CardShadow"
                                              Color="#000000"
                                              BlurRadius="14"
                                              ShadowDepth="4"
                                              Opacity="0.45" />
                        </Border.Effect>
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="CardBorder" Property="BorderBrush" Value="{StaticResource RokuAccentBrightBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter Property="Panel.ZIndex" Value="50" />
                            <Setter TargetName="CardBorder" Property="BorderBrush" Value="{StaticResource RokuFocusBorderBrush}" />
                            <Setter TargetName="CardBorder" Property="BorderThickness" Value="3.5" />
                            <Setter TargetName="CardBorder" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect Color="#9D6BFF" BlurRadius="26" ShadowDepth="0" Opacity="0.9" />
                                </Setter.Value>
                            </Setter>
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                         To="1.06" Duration="0:0:0.13">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                         To="1.06" Duration="0:0:0.13">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                         To="1.0" Duration="0:0:0.12" />
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                         To="1.0" Duration="0:0:0.12" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Action Button for Dialogs / Overlays -->
    <Style x:Key="RokuActionButtonStyle" TargetType="Button">
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Background" Value="{StaticResource RokuSurfaceBrush}" />
        <Setter Property="Foreground" Value="{StaticResource RokuTextPrimaryBrush}" />
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="26,12" />
        <Setter Property="MinWidth" Value="150" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="BtnBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{StaticResource RokuSubtleBorderBrush}"
                            BorderThickness="2"
                            CornerRadius="10"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="BtnBorder" Property="Background" Value="{StaticResource RokuSurfaceHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="BtnBorder" Property="Background" Value="{StaticResource RokuAccentBrush}" />
                            <Setter TargetName="BtnBorder" Property="BorderBrush" Value="{StaticResource RokuFocusBorderBrush}" />
                            <Setter Property="Foreground" Value="#FFFFFF" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Roku Full-Width Selectable Row Button (App Manager / Settings Lists) -->
    <Style x:Key="RokuListRowButtonStyle" TargetType="Button">
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Background" Value="#1E1338" />
        <Setter Property="Foreground" Value="{StaticResource RokuTextPrimaryBrush}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Padding" Value="18,12" />
        <Setter Property="Margin" Value="0,5" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="RowBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{StaticResource RokuSubtleBorderBrush}"
                            BorderThickness="2"
                            CornerRadius="12"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="RowBorder" Property="Background" Value="{StaticResource RokuSurfaceHoverBrush}" />
                            <Setter TargetName="RowBorder" Property="BorderBrush" Value="{StaticResource RokuAccentBrightBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="RowBorder" Property="Background" Value="#342063" />
                            <Setter TargetName="RowBorder" Property="BorderBrush" Value="{StaticResource RokuFocusBorderBrush}" />
                            <Setter TargetName="RowBorder" Property="BorderThickness" Value="3" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Roku Dark TextBox Style -->
    <Style x:Key="RokuTextBoxStyle" TargetType="TextBox">
        <Setter Property="Background" Value="#191030" />
        <Setter Property="Foreground" Value="{StaticResource RokuTextPrimaryBrush}" />
        <Setter Property="CaretBrush" Value="#FFFFFF" />
        <Setter Property="BorderBrush" Value="{StaticResource RokuSubtleBorderBrush}" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="Padding" Value="14,10" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="InputBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="10">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Margin="2"
                                      VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="InputBorder" Property="BorderBrush" Value="{StaticResource RokuFocusBorderBrush}" />
                            <Setter TargetName="InputBorder" Property="Background" Value="#241745" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
