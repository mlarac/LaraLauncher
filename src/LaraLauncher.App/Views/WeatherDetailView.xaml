<UserControl x:Class="LaraLauncher.App.Views.WeatherDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Focusable="False">
        <StackPanel Margin="12,0,12,16">

            <!-- Current Weather Hero Card -->
            <Border Visibility="{Binding HasForecast, Converter={StaticResource BoolToVisibility}}"
                    Background="#21143E"
                    BorderBrush="{StaticResource RokuSubtleBorderBrush}"
                    BorderThickness="1.5"
                    CornerRadius="18"
                    Padding="32,26"
                    Margin="0,0,0,22">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Icon & Big Temperature -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,32,0">
                        <TextBlock Text="{Binding CurrentIcon}"
                                   FontFamily="Segoe UI Emoji"
                                   FontSize="64"
                                   VerticalAlignment="Center"
                                   Margin="0,0,20,0" />
                        <TextBlock Text="{Binding CurrentTempText}"
                                   FontSize="62"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource RokuTextPrimaryBrush}"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- Location & Conditions -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding LocationTitle}"
                                   FontSize="24"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource RokuTextPrimaryBrush}"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding CurrentConditionText}"
                                   FontSize="19"
                                   Foreground="{StaticResource RokuAccentBrightBrush}"
                                   Margin="0,4,0,0" />
                        <TextBlock Text="{Binding CurrentDetailsText}"
                                   FontSize="14"
                                   Foreground="{StaticResource RokuTextMutedBrush}"
                                   Margin="0,8,0,0" />
                        <TextBlock Text="{Binding LastUpdatedText}"
                                   FontSize="12"
                                   Foreground="{StaticResource RokuTextMutedBrush}"
                                   Opacity="0.8"
                                   Margin="0,4,0,0" />
                    </StackPanel>

                    <!-- Actions -->
                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <Button x:Name="RefreshWeatherButton"
                                Content="Actualizar"
                                Style="{StaticResource RokuActionButtonStyle}"
                                FontSize="15"
                                Padding="20,10"
                                MinWidth="150"
                                Margin="0,0,0,10"
                                Click="RefreshWeatherButton_Click" />
                        <Button x:Name="ChangeCityButton"
                                Content="Cambiar ciudad"
                                Style="{StaticResource RokuActionButtonStyle}"
                                FontSize="15"
                                Padding="20,10"
                                MinWidth="150"
                                Click="ChangeCityButton_Click" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- City Search Picker (Shown initially or when changing city) -->
            <Border Visibility="{Binding IsCityPickerVisible, Converter={StaticResource BoolToVisibility}}"
                    Background="#1F143B"
                    BorderBrush="{StaticResource RokuAccentBrightBrush}"
                    BorderThickness="1.5"
                    CornerRadius="16"
                    Padding="28,24"
                    Margin="0,0,0,22">
                <StackPanel>
                    <TextBlock Text="Seleccionar ciudad para el pronóstico"
                               FontSize="22"
                               FontWeight="Bold"
                               Margin="0,0,0,14" />

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBox x:Name="CitySearchBox"
                                 Grid.Column="0"
                                 Style="{StaticResource RokuTextBoxStyle}"
                                 Text="{Binding CitySearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,12,0"
                                 KeyDown="CitySearchBox_KeyDown" />

                        <Button x:Name="SearchCityButton"
                                Grid.Column="1"
                                Content="Buscar"
                                Style="{StaticResource RokuActionButtonStyle}"
                                FontSize="15"
                                Padding="22,10"
                                MinWidth="120"
                                Margin="0,0,10,0"
                                Click="SearchCityButton_Click" />

                        <Button x:Name="CloseCityPickerButton"
                                Grid.Column="2"
                                Content="Cancelar"
                                Visibility="{Binding HasForecast, Converter={StaticResource BoolToVisibility}}"
                                Style="{StaticResource RokuActionButtonStyle}"
                                FontSize="15"
                                Padding="18,10"
                                MinWidth="110"
                                Click="CloseCityPickerButton_Click" />
                    </Grid>

                    <TextBlock Text="{Binding CitySearchStatus}"
                               FontSize="14"
                               Foreground="{StaticResource RokuTextMutedBrush}"
                               Margin="2,0,0,10" />

                    <ItemsControl x:Name="CityResultsList"
                                  ItemsSource="{Binding CitySearchResults}"
                                  Visibility="{Binding HasCitySearchResults, Converter={StaticResource BoolToVisibility}}"
                                  Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource RokuListRowButtonStyle}"
                                        Click="CityResultButton_Click"
                                        GotKeyboardFocus="CityResultButton_GotKeyboardFocus">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right"
                                                   Text="Seleccionar ›"
                                                   FontSize="14"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource RokuAccentBrightBrush}"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding DisplayName}"
                                                   FontSize="17"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center" />
                                    </DockPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- 7-Day Forecast Cards -->
            <StackPanel Visibility="{Binding HasForecast, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="Próximos días"
                           FontSize="22"
                           FontWeight="Bold"
                           Margin="4,0,0,14" />

                <ItemsControl ItemsSource="{Binding ForecastDays}" Focusable="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="7" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#1F143B"
                                    BorderBrush="{StaticResource RokuSubtleBorderBrush}"
                                    BorderThickness="1.5"
                                    CornerRadius="14"
                                    Padding="12,18"
                                    Margin="5">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding DayLabel}"
                                               FontSize="17"
                                               FontWeight="Bold"
                                               HorizontalAlignment="Center"
                                               Foreground="{StaticResource RokuTextPrimaryBrush}" />
                                    <TextBlock Text="{Binding DateLabel}"
                                               FontSize="12"
                                               HorizontalAlignment="Center"
                                               Foreground="{StaticResource RokuTextMutedBrush}"
                                               Margin="0,2,0,12" />

                                    <TextBlock Text="{Binding Icon}"
                                               FontFamily="Segoe UI Emoji"
                                               FontSize="36"
                                               HorizontalAlignment="Center"
                                               Margin="0,0,0,10" />

                                    <TextBlock Text="{Binding ConditionText}"
                                               FontSize="12"
                                               Foreground="{StaticResource RokuTextMutedBrush}"
                                               TextAlignment="Center"
                                               TextWrapping="Wrap"
                                               MinHeight="32"
                                               HorizontalAlignment="Center"
                                               Margin="0,0,0,10" />

                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,6">
                                        <TextBlock Text="{Binding MaxTempText}"
                                                   FontSize="20"
                                                   FontWeight="Bold"
                                                   Foreground="#FFFFFF"
                                                   Margin="0,0,8,0" />
                                        <TextBlock Text="{Binding MinTempText}"
                                                   FontSize="17"
                                                   Foreground="{StaticResource RokuTextMutedBrush}"
                                                   VerticalAlignment="Bottom" />
                                    </StackPanel>

                                    <TextBlock Text="{Binding RainChanceText}"
                                               FontSize="12"
                                               Foreground="{StaticResource RokuAccentBrightBrush}"
                                               HorizontalAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</UserControl>
